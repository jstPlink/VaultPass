# Tutte le variabili sono facoltative: senza .env vengono usati i valori predefiniti.

# Segreto per le sessioni. Se vuoto, viene generato e salvato in data/jwt_secret.
JWT_SECRET=

# Porta dell'app sul NAS (a cui punta Cloudflare Tunnel)
APP_PORT=3000

# true se l'app è raggiungibile in HTTPS (es. tramite Cloudflare)
COOKIE_SECURE=true
SESSION_HOURS=12

# Metti false per chiudere le nuove registrazioni dopo aver creato i tuoi utenti
ALLOW_REGISTRATION=true

TZ=Europe/Rome

# Solo sviluppo in locale: se impostato, l'app locale usa l'interfaccia dei file locali
# ma inoltra le chiamate /api a questo server, quindi vedi e MODIFICHI i dati reali.
# Lascialo vuoto per usare il database locale (data/vaultpass.db).
REMOTE_URL=
